{
  "name": "story-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "worker": "tsx worker/index.ts",
    "worker:youtube": "tsx worker/youtube.ts",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sample": "tsx scripts/sample.ts",
    "test:acceptance": "tsx scripts/acceptance.ts",
    "test:recovery": "tsx scripts/recovery.ts",
    "test:mcp": "tsx scripts/mcp-acceptance.ts",
    "format": "prettier --write app components lib worker scripts tests docs *.json *.ts *.mjs compose.yaml"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@prisma/client": "^6.19.0",
    "bullmq": "^5.61.0",
    "dotenv": "^17.2.0",
    "ioredis": "^5.8.0",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "prisma": "^6.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
