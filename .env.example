DATABASE_URL=postgresql://studio:studio@localhost:55432/studio
REDIS_URL=redis://localhost:56379
POSTGRES_PORT=55432
REDIS_PORT=56379
OWNER_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
# Exactly 64 hexadecimal characters (32 random bytes). Never rotate without re-encrypting profiles/jobs.
ENCRYPTION_KEY=replace-with-64-hex-characters
APP_ORIGIN=http://localhost:3000
MEDIA_ROOT=./data/media
MAX_UPLOAD_MB=100
MAX_DOWNLOAD_MB=100
WORKER_CONCURRENCY=2
ALLOW_LOCAL_PROVIDERS=false
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FONT_DIR=./public/fonts
