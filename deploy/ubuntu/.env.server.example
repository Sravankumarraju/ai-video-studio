# Copy to .env.server ON THE SERVER. Never commit .env.server.
# Use hexadecimal passwords to avoid URL escaping in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-random-hex-password
OWNER_PASSWORD=replace-with-long-unique-owner-password
SESSION_SECRET=replace-with-at-least-32-random-characters
# Exactly 64 hexadecimal characters. Preserve the original encryption key
# when migrating existing encrypted provider profiles and OAuth records.
ENCRYPTION_KEY=replace-with-64-hex-characters
# Initial SSH tunnel: ssh -L 3000:127.0.0.1:3000 user@103.207.183.11
# Change to the exact HTTPS origin when a domain/reverse proxy is configured.
APP_ORIGIN=http://localhost:3000
WORKER_CONCURRENCY=1
ALLOW_LOCAL_PROVIDERS=false
STORAGE_DRIVER=local
MAX_UPLOAD_MB=100
MAX_DOWNLOAD_MB=100
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
